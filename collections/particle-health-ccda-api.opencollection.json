{
  "opencollection": "1.0.0",
  "info": {
    "name": "Particle Health Authentication CCDA API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "CCDA",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get CCDA Files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.particlehealth.com/api/v2/patients/:particle_patient_id/ccda",
            "params": [
              {
                "name": "particle_patient_id",
                "value": "",
                "type": "path",
                "description": "Particle Patient ID (PPID)"
              }
            ]
          },
          "docs": "Download a zip of CCDA files or a single CCDA document for a patient."
        }
      ]
    }
  ],
  "bundled": true
}