        {
          "info": {
            "name": "Get Flat Patient",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.particlehealth.com/flat/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Flat Patient"
        },
        {
          "info": {
            "name": "Collect Flat Datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.particlehealth.com/flat/:id/collect-data",
