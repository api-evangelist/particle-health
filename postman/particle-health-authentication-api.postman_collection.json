        {
          "name": "Generate a JSON Web Token",
          "id": "6e9f2b64-d68c-43b4-a803-fa1ac8ab26cc",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "description": "(Required) ",
                "key": "client_id",
                "value": "<string>"
              },
              {
                "description": "(Required) ",
                "key": "client_secret",
                "value": "<string>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
